# JULES backend (Express + tRPC + MongoDB)
NODE_ENV=production
PORT=3000

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/jules

# Long random secret used to sign login sessions
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Owner account: created on first start and always kept as an active Super Admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=JULES Super Admin

# JulesBot AI: any OpenAI-compatible chat API
LLM_API_KEY=
# Optional (defaults: https://api.openai.com/v1 and gpt-4o-mini)
# Gemini example: LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_API_URL=
LLM_MODEL=

# Optional: Manus Forge proxy (only for Manus-hosted builds; also used for catalog cover uploads)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: set to "true" to stop start-up when a database migration fails
MIGRATIONS_STRICT=false
